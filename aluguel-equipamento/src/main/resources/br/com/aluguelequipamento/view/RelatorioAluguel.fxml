<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="br.com.aluguelequipamento.controller.RelatorioAluguelController"
            prefWidth="920" prefHeight="420"
            style="-fx-background-color: #f0f2f5;"
            stylesheets="@css/relatorio.css">

    <!-- ══ TOPO ══ -->
    <top>
        <HBox style="-fx-background-color: #2a5480; -fx-padding: 12 20;"
              alignment="CENTER_LEFT" spacing="14">
             <Button text="←" onAction="#switchToPrimary" styleClass="btn-top-back"/>
            <Label text="REL"
                   style="-fx-font-size: 11; -fx-font-weight: bold;
                          -fx-text-fill: #aacce8; -fx-padding: 4 10;
                          -fx-background-color: #1a3a5c; -fx-background-radius: 4;"/>
            <VBox>
                <Label text="Relatório de Aluguel"
                       style="-fx-font-size: 16; -fx-font-weight: bold; -fx-text-fill: white;"/>
                <Label text="Retiradas e devoluções filtradas por período"
                       style="-fx-font-size: 11; -fx-text-fill: #aacce8;"/>
            </VBox>
        </HBox>
    </top>

    <!-- ══ CENTRO ══ -->
    <center>
        <VBox spacing="20" style="-fx-padding: 30 40;">

            <!-- ── Card de filtro ── -->
            <VBox styleClass="card-filtro" spacing="0">

                <HBox styleClass="card-header" alignment="CENTER_LEFT" spacing="10">
                    <Label text="FILTRO POR PERÍODO" styleClass="section-label-inline"/>
                </HBox>

                <GridPane hgap="20" vgap="14" style="-fx-padding: 20 24;">
                    <columnConstraints>
                        <ColumnConstraints minWidth="120" halignment="RIGHT"/>
                        <ColumnConstraints minWidth="180" hgrow="SOMETIMES"/>
                        <ColumnConstraints minWidth="120" halignment="RIGHT"/>
                        <ColumnConstraints minWidth="180" hgrow="SOMETIMES"/>
                        <ColumnConstraints hgrow="ALWAYS"/>
                    </columnConstraints>

                    <Label text="Data Início *" styleClass="field-label"
                           GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                    <DatePicker fx:id="dpDataInicio" maxWidth="Infinity"
                                styleClass="field-input"
                                GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                    <Label text="Data Fim *" styleClass="field-label"
                           GridPane.rowIndex="0" GridPane.columnIndex="2"/>
                    <DatePicker fx:id="dpDataFim" maxWidth="Infinity"
                                styleClass="field-input"
                                GridPane.rowIndex="0" GridPane.columnIndex="3"/>
                </GridPane>

                <!-- Botões -->
                <HBox spacing="10" alignment="CENTER_RIGHT"
                      style="-fx-padding: 0 24 18 24;">
                    <Button fx:id="btnGerar"
                            text="▶  Gerar Relatório"
                            styleClass="btn-primary"
                            onAction="#handleGerarRelatorio"
                            prefWidth="160"/>
                    <Button text="↺  Limpar"
                            styleClass="btn-secondary"
                            onAction="#handleLimpar"
                            prefWidth="100"/>
                </HBox>

            </VBox>

            <!-- ── Card informativo ── -->
            <VBox styleClass="card-info" spacing="10" style="-fx-padding: 18 22;">
                <Label text="O que este relatório exibe:"
                       style="-fx-font-size: 12; -fx-font-weight: bold; -fx-text-fill: #1a3a5c;"/>
                <VBox spacing="6">
                    <Label text="  ●  Todas as retiradas no período informado (por data de retirada)"
                           styleClass="info-item"/>
                    <Label text="  ●  Data de devolução efetiva (quando houver)"
                           styleClass="info-item"/>
                    <Label text="  ●  Totalizadores: quantidade de registros e soma dos aluguéis"
                           styleClass="info-item"/>
                    <Label text="  ●  O relatório é gerado em formato A4 paisagem e pode ser impresso ou exportado para PDF"
                           styleClass="info-item"/>
                </VBox>
            </VBox>

        </VBox>
    </center>

    <!-- ══ RODAPÉ ══ -->
    <bottom>
        <HBox style="-fx-background-color: #1a3a5c; -fx-padding: 7 16;"
              spacing="12" alignment="CENTER_LEFT">
            <Label text="Relatório de Aluguel"
                   style="-fx-text-fill: #aacce8; -fx-font-size: 11;"/>
            <Label text="|" style="-fx-text-fill: #3a5a7c;"/>
            <Label fx:id="lblStatus" text="Selecione o período e clique em Gerar Relatório."
                   style="-fx-text-fill: #aacce8; -fx-font-size: 11;"/>
        </HBox>
    </bottom>

</BorderPane>
