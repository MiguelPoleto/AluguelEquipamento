<?xml version="1.0" encoding="UTF-8"?>

<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports
    http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
    name="relatorio-reservas"
    pageWidth="842"
    pageHeight="595"
    orientation="Landscape"
    columnWidth="802"
    leftMargin="20"
    rightMargin="20"
    topMargin="20"
    bottomMargin="20">

    <!-- PARÂMETROS -->
    <parameter name="P_STATUS" class="java.lang.String"/>
    <parameter name="P_CLIENTE_ID" class="java.lang.Integer"/>
    <parameter name="P_EQUIPAMENTO_ID" class="java.lang.Integer"/>

    <!-- QUERY -->
    <queryString>
        <![CDATA[
        SELECT
            r.id,
            c.nome AS cliente,
            e.nome AS equipamento,
            r.data_inicio,
            r.data_fim,
            r.status,
            r.observacao
        FROM reserva r
        JOIN cliente c ON c.id = r.cliente_id
        JOIN equipamento e ON e.id = r.equipamento_id
        WHERE r.status LIKE $P{P_STATUS}
          AND ($P{P_CLIENTE_ID} = 0 OR c.id = $P{P_CLIENTE_ID})
          AND ($P{P_EQUIPAMENTO_ID} = 0 OR e.id = $P{P_EQUIPAMENTO_ID})
        ORDER BY r.data_inicio DESC
        ]]>
    </queryString>

    <!-- CAMPOS -->
    <field name="id" class="java.lang.Integer"/>
    <field name="cliente" class="java.lang.String"/>
    <field name="equipamento" class="java.lang.String"/>
    <field name="data_inicio" class="java.sql.Date"/>
    <field name="data_fim" class="java.sql.Date"/>
    <field name="status" class="java.lang.String"/>
    <field name="observacao" class="java.lang.String"/>

    <!-- TÍTULO -->
    <title>
        <band height="40">
            <staticText>
                <reportElement x="0" y="5" width="500" height="30"/>
                <textElement>
                    <font size="18" isBold="true"/>
                </textElement>
                <text><![CDATA[RELATÓRIO DE RESERVAS]]></text>
            </staticText>
        </band>
    </title>

    <!-- CABEÇALHO -->
    <columnHeader>
        <band height="25">

            <staticText>
                <reportElement x="0" y="0" width="40" height="20"/>
                <text><![CDATA[ID]]></text>
            </staticText>

            <staticText>
                <reportElement x="45" y="0" width="180" height="20"/>
                <text><![CDATA[Cliente]]></text>
            </staticText>

            <staticText>
                <reportElement x="230" y="0" width="180" height="20"/>
                <text><![CDATA[Equipamento]]></text>
            </staticText>

            <staticText>
                <reportElement x="415" y="0" width="80" height="20"/>
                <text><![CDATA[Início]]></text>
            </staticText>

            <staticText>
                <reportElement x="500" y="0" width="80" height="20"/>
                <text><![CDATA[Fim]]></text>
            </staticText>

            <staticText>
                <reportElement x="585" y="0" width="100" height="20"/>
                <text><![CDATA[Status]]></text>
            </staticText>

            <staticText>
                <reportElement x="690" y="0" width="120" height="20"/>
                <text><![CDATA[Observação]]></text>
            </staticText>

        </band>
    </columnHeader>

    <!-- DETALHES -->
    <detail>
        <band height="22">

            <textField>
                <reportElement x="0" y="0" width="40" height="20"/>
                <textFieldExpression><![CDATA[$F{id}]]></textFieldExpression>
            </textField>

            <textField>
                <reportElement x="45" y="0" width="180" height="20"/>
                <textFieldExpression><![CDATA[$F{cliente}]]></textFieldExpression>
            </textField>

            <textField>
                <reportElement x="230" y="0" width="180" height="20"/>
                <textFieldExpression><![CDATA[$F{equipamento}]]></textFieldExpression>
            </textField>

            <textField pattern="dd/MM/yyyy">
                <reportElement x="415" y="0" width="80" height="20"/>
                <textFieldExpression><![CDATA[$F{data_inicio}]]></textFieldExpression>
            </textField>

            <textField pattern="dd/MM/yyyy">
                <reportElement x="500" y="0" width="80" height="20"/>
                <textFieldExpression><![CDATA[$F{data_fim}]]></textFieldExpression>
            </textField>

            <textField>
                <reportElement x="585" y="0" width="100" height="20"/>
                <textFieldExpression><![CDATA[$F{status}]]></textFieldExpression>
            </textField>

            <textField>
                <reportElement x="690" y="0" width="120" height="20"/>
                <textFieldExpression><![CDATA[$F{observacao}]]></textFieldExpression>
            </textField>

        </band>
    </detail>

</jasperReport>