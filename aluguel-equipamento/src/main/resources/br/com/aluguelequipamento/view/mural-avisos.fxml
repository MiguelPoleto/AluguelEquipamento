<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="700" prefWidth="1100" style="-fx-background-color: #f4f7fb;" stylesheets="@css/mural-avisos.css" xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/26" fx:controller="br.com.aluguelequipamento.controller.MuralAvisosController">

    <top>
        <VBox>
            <HBox alignment="CENTER_LEFT" spacing="12" styleClass="topbar">
                <Button onAction="#voltar" styleClass="btn-secondary" text="Voltar" />
                <VBox spacing="2">
                    <Label styleClass="page-title" text="Mural de Avisos" />
                    <Label styleClass="page-subtitle" text="Threads e sockets" />
                </VBox>
            </HBox>
        </VBox>
    </top>

    <center>
        <VBox spacing="18" styleClass="content">
            <HBox alignment="CENTER_LEFT" spacing="18">
                <VBox spacing="10" styleClass="panel" HBox.hgrow="ALWAYS">
                    <Label styleClass="panel-title" text="Conexão com o Servidor" />
                    <HBox alignment="CENTER_LEFT" spacing="10">
                        <TextField fx:id="txtGrupo" prefWidth="140" promptText="Grupo 1 a 10" />
                        <Button fx:id="btnConectar" onAction="#conectarServidor" styleClass="btn-primary" text="Conectar ao Servidor" />
                    </HBox>
                </VBox>

                <VBox spacing="8" styleClass="panel" HBox.hgrow="ALWAYS">
                    <Label fx:id="lblGrupoAtual" styleClass="panel-title-blue" text="Nenhum grupo carregado" />
                    <Label fx:id="lblTemaGrupo" styleClass="muted" text="Aguardando conexão" />
                </VBox>

                <VBox spacing="8" styleClass="panel" HBox.hgrow="ALWAYS">
                    <Label styleClass="panel-title-green" text="Mensagens carregadas" />
                    <HBox spacing="6">
                        <Label styleClass="muted" text="Última atualização:" />
                        <Label fx:id="lblUltimaAtualizacao" styleClass="muted-strong" text="-" />
                    </HBox>
                    <Label fx:id="lblStatus" styleClass="status" text="Aguardando conexão." />
                </VBox>
            </HBox>

            <SplitPane dividerPositions="0.38" VBox.vgrow="ALWAYS">
                <VBox spacing="12" styleClass="panel">
                    <Label styleClass="section-title" text="Ranking Geral" />
                    <TableView fx:id="tabelaRanking" VBox.vgrow="ALWAYS">
                        <columns>
                            <TableColumn fx:id="colPosicao" prefWidth="70" text="Pos." />
                            <TableColumn fx:id="colGrupo" prefWidth="270" text="Grupo" />
                            <TableColumn fx:id="colAcessos" prefWidth="95" text="Acessos" />
                        </columns>
                  <columnResizePolicy>
                     <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                  </columnResizePolicy>
                    </TableView>
                </VBox>

                <VBox spacing="14" styleClass="panel">
                    <Label styleClass="section-title" text="Aviso em Destaque" />
                    <Label fx:id="lblTituloDestaque" styleClass="highlight-title" text="Sem aviso selecionado" />
                    <VBox spacing="8" styleClass="highlight-box">
                        <Label fx:id="lblMensagemDestaque" styleClass="highlight-message" text="Os avisos recebidos do servidor aparecerão aqui." wrapText="true" />
                    </VBox>
                    <Label fx:id="lblTimestampDestaque" styleClass="muted" text="-" />
                    <Label fx:id="lblTotalAvisos" styleClass="muted-strong" text="0 avisos recebidos" />
                    <Label styleClass="section-title" text="Mensagens do Grupo" />
                    <ListView fx:id="listaAvisos" VBox.vgrow="ALWAYS" />
                </VBox>
            </SplitPane>
        </VBox>
    </center>
</BorderPane>
