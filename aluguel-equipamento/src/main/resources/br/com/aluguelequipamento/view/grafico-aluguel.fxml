<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.chart.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="br.com.aluguelequipamento.controller.GraficoAluguelController"
            prefWidth="960" prefHeight="640"
            stylesheets="@css/graficos.css">

    <top>
        <HBox styleClass="header" alignment="CENTER_LEFT" spacing="14">
            <Button text="←" onAction="#voltarMenu" styleClass="btn-top-back"/>
            <Label text="ALU" styleClass="card-tag tag-retirada"/>
            <VBox>
                <Label text="Grafico - Aluguel" styleClass="header-title"/>
                <Label text="Alugueis por equipamento e distribuicao por status" styleClass="header-subtitle"/>
            </VBox>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="lblAluguelTotal" text="0 aluguel(is)" styleClass="summary-pill retirada-pill"/>
            <Button text="Atualizar" onAction="#carregarGraficos" styleClass="btn-refresh"/>
        </HBox>
    </top>

    <center>
        <HBox spacing="16" styleClass="content">
            <VBox spacing="10" styleClass="chart-panel" HBox.hgrow="ALWAYS">
                <Label text="Alugueis por Equipamento" styleClass="panel-title"/>
                <BarChart fx:id="chartAluguelEquipamento" legendVisible="false" animated="false" VBox.vgrow="ALWAYS">
                    <xAxis>
                        <CategoryAxis label="Equipamento"/>
                    </xAxis>
                    <yAxis>
                        <NumberAxis label="Quantidade" tickUnit="1" minorTickVisible="false"/>
                    </yAxis>
                </BarChart>
            </VBox>

            <VBox spacing="10" styleClass="chart-panel side-chart">
                <Label text="Alugueis por Status" styleClass="panel-title"/>
                <PieChart fx:id="chartAluguelStatus" labelsVisible="true" legendVisible="true" VBox.vgrow="ALWAYS"/>
            </VBox>
        </HBox>
    </center>

    <bottom>
        <HBox styleClass="footer" spacing="12" alignment="CENTER_LEFT">
            <Label text="Grafico de Aluguel" styleClass="footer-text"/>
            <Label text="|" styleClass="footer-separator"/>
            <Label text="Consultas com COUNT, GROUP BY e JOIN" styleClass="footer-text"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="lblErro" text="" wrapText="true" styleClass="error-label"/>
            <Button text="← Voltar ao Menu" onAction="#voltarMenu" styleClass="btn-back-footer"/>
        </HBox>
    </bottom>
</BorderPane>
