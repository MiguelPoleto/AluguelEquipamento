<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="br.com.aluguelequipamento.controller.RelatorioManutencaoController"
            prefWidth="960" prefHeight="640"
            stylesheets="@css/relatorio-manutencao.css">

    <!-- TOPO -->
    <top>
        <VBox>
            <HBox styleClass="header" alignment="CENTER_LEFT" spacing="14">
                <Button text="←" onAction="#voltarMenu" styleClass="btn-top-back"/>
                <Label text="MAN" styleClass="card-tag"/>
                <VBox>
                    <Label text="Relatório — Manutenção de Equipamentos" styleClass="header-title"/>
                    <Label text="Filtros por status, equipamento e data de entrada" styleClass="header-subtitle"/>
                </VBox>
                <Region HBox.hgrow="ALWAYS"/>
                <Label fx:id="lblContador" text="0 manutenções" styleClass="contador-label"/>
            </HBox>
        </VBox>
    </top>

    <!-- CENTRO -->
    <center>
        <VBox spacing="14" styleClass="content">

            <!-- Painel de filtros + botão Imprimir -->
            <VBox styleClass="filter-panel" spacing="10">
                <HBox alignment="CENTER_LEFT" spacing="0">
                    <Label text="FILTROS" styleClass="section-label"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <!-- Botão Imprimir — respeita os filtros ativos -->
                    <Button text="🖨  Imprimir" onAction="#imprimir" styleClass="btn-print"/>
                </HBox>

                <GridPane hgap="12" vgap="8">
                    <columnConstraints>
                        <ColumnConstraints percentWidth="18"/>
                        <ColumnConstraints percentWidth="26"/>
                        <ColumnConstraints percentWidth="14"/>
                        <ColumnConstraints percentWidth="14"/>
                        <ColumnConstraints percentWidth="14"/>
                        <ColumnConstraints percentWidth="14"/>
                    </columnConstraints>

                    <Label text="Status" styleClass="field-label"
                           GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                    <Label text="Equipamento" styleClass="field-label"
                           GridPane.columnIndex="1" GridPane.rowIndex="0"/>
                    <Label text="Entrada — De" styleClass="field-label"
                           GridPane.columnIndex="2" GridPane.rowIndex="0"/>
                    <Label text="Entrada — Até" styleClass="field-label"
                           GridPane.columnIndex="3" GridPane.rowIndex="0"/>

                    <ComboBox fx:id="cbFiltroStatus"
                              maxWidth="Infinity" styleClass="input"
                              GridPane.columnIndex="0" GridPane.rowIndex="1"/>

                    <ComboBox fx:id="cbFiltroEquipamento"
                              promptText="Todos os equipamentos"
                              maxWidth="Infinity" styleClass="input"
                              GridPane.columnIndex="1" GridPane.rowIndex="1"/>

                    <DatePicker fx:id="dpFiltroDataDe"
                                maxWidth="Infinity" styleClass="input"
                                GridPane.columnIndex="2" GridPane.rowIndex="1"/>

                    <DatePicker fx:id="dpFiltroDataAte"
                                maxWidth="Infinity" styleClass="input"
                                GridPane.columnIndex="3" GridPane.rowIndex="1"/>

                    <Button text="Filtrar"
                            onAction="#filtrar"
                            maxWidth="Infinity" styleClass="btn-primary"
                            GridPane.columnIndex="4" GridPane.rowIndex="1"/>

                    <Button text="Todos"
                            onAction="#listarTodos"
                            maxWidth="Infinity" styleClass="btn-secondary"
                            GridPane.columnIndex="5" GridPane.rowIndex="1"/>
                </GridPane>
            </VBox>

            <!-- Tabela -->
            <VBox styleClass="table-container" VBox.vgrow="ALWAYS">
                <TableView fx:id="tableManutencoes"
                           VBox.vgrow="ALWAYS"
                           styleClass="table">
                    <columns>
                        <TableColumn fx:id="colId"           text="ID"          prefWidth="40"/>
                        <TableColumn fx:id="colEquipamento"  text="Equipamento" prefWidth="165"/>
                        <TableColumn fx:id="colDataInicio"   text="Entrada"     prefWidth="88"/>
                        <TableColumn fx:id="colDataPrevisao" text="Previsão"    prefWidth="88"/>
                        <TableColumn fx:id="colDataFim"      text="Conclusão"   prefWidth="88"/>
                        <TableColumn fx:id="colStatus"       text="Status"      prefWidth="105"/>
                        <TableColumn fx:id="colDescricao"    text="Descrição"   prefWidth="200"/>
                    </columns>
                    <placeholder>
                        <VBox alignment="CENTER" spacing="6" style="-fx-padding: 30;">
                            <Label style="-fx-font-size: 13; -fx-text-fill: #8a9bb0;"
                                   text="Nenhuma manutenção encontrada."/>
                            <Label style="-fx-font-size: 11; -fx-text-fill: #b0bec5;"
                                   text="Ajuste os filtros ou clique em 'Todos'."/>
                        </VBox>
                    </placeholder>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                    </columnResizePolicy>
                </TableView>
            </VBox>

            <!-- Mensagem de erro / aviso -->
            <Label fx:id="lblErro" text="" wrapText="true" styleClass="error-label"/>

        </VBox>
    </center>

    <!-- RODAPÉ -->
    <bottom>
        <HBox styleClass="footer" spacing="12" alignment="CENTER_LEFT">
            <Label text="Relatório de Manutenção" styleClass="footer-text"/>
            <Label text="|" styleClass="footer-separator"/>
            <Label text="Sistema de Aluguel de Equipamentos v1.0" styleClass="footer-text"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="← Voltar ao Menu" onAction="#voltarMenu" styleClass="btn-back-footer"/>
        </HBox>
    </bottom>

</BorderPane>