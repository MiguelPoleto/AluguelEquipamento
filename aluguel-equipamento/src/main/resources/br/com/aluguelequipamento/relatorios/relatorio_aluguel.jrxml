<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports
                                  http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="relatorio_aluguel"
              pageWidth="842" pageHeight="595"
              orientation="Landscape"
              columnWidth="802"
              leftMargin="20" rightMargin="20"
              topMargin="20" bottomMargin="20"
              whenNoDataType="AllSectionsNoDetail">

    <!-- Parametros -->
    <parameter name="PERIODO" class="java.lang.String">
        <defaultValueExpression><![CDATA["Todos os períodos"]]></defaultValueExpression>
    </parameter>

    <!-- Campos do relatorio -->
    <field name="id" class="java.lang.Integer"/>
    <field name="nomeCliente" class="java.lang.String"/>
    <field name="nomeEquipamento" class="java.lang.String"/>
    <field name="dataRetirada" class="java.lang.String"/>
    <field name="dataPrevDevolucao" class="java.lang.String"/>
    <field name="dataDevolucao" class="java.lang.String"/>
    <field name="valorTotal" class="java.math.BigDecimal"/>
    <field name="status" class="java.lang.String"/>

    <!-- Variaveis totalizadoras -->
    <variable name="SUM_VALOR" class="java.math.BigDecimal" calculation="Sum">
        <variableExpression><![CDATA[$F{valorTotal}]]></variableExpression>
        <initialValueExpression><![CDATA[java.math.BigDecimal.ZERO]]></initialValueExpression>
    </variable>
    <variable name="COUNT_ROWS" class="java.lang.Integer" calculation="Count">
        <variableExpression><![CDATA[$F{id}]]></variableExpression>
    </variable>

    <!-- Titulo -->
    <title>
        <band height="62" splitType="Stretch">
            <rectangle>
                <reportElement x="0" y="0" width="802" height="52"
                               backcolor="#2A5480" forecolor="#2A5480" mode="Opaque"/>
            </rectangle>

            <staticText>
                <reportElement x="12" y="8" width="600" height="22" forecolor="#FFFFFF"/>
                <textElement verticalAlignment="Middle">
                    <font fontName="SansSerif" size="15" isBold="true"/>
                </textElement>
                <text><![CDATA[RELATÓRIO DE ALUGUEL DE EQUIPAMENTOS]]></text>
            </staticText>

            <textField isBlankWhenNull="true">
                <reportElement x="12" y="32" width="500" height="14" forecolor="#AACCE8"/>
                <textElement>
                    <font fontName="SansSerif" size="9"/>
                </textElement>
                <textFieldExpression><![CDATA["Período: " + $P{PERIODO}]]></textFieldExpression>
            </textField>

            <textField pattern="dd/MM/yyyy HH:mm">
                <reportElement x="600" y="10" width="192" height="14" forecolor="#AACCE8"/>
                <textElement textAlignment="Right">
                    <font fontName="SansSerif" size="8"/>
                </textElement>
                <textFieldExpression><![CDATA[new java.util.Date()]]></textFieldExpression>
            </textField>

            <staticText>
                <reportElement x="600" y="26" width="192" height="14" forecolor="#AACCE8"/>
                <textElement textAlignment="Right">
                    <font fontName="SansSerif" size="8"/>
                </textElement>
                <text><![CDATA[Sistema de Aluguel de Equipamentos]]></text>
            </staticText>

            <line>
                <reportElement x="0" y="58" width="802" height="1" forecolor="#DDE1E7"/>
            </line>
        </band>
    </title>

    <!-- Cabecalho das colunas -->
    <columnHeader>
        <band height="26" splitType="Stretch">
            <rectangle>
                <reportElement x="0" y="0" width="802" height="26"
                               backcolor="#1A3A5C" forecolor="#1A3A5C" mode="Opaque"/>
            </rectangle>

            <staticText>
                <reportElement x="2" y="5" width="33" height="14" forecolor="#FFFFFF"/>
                <textElement textAlignment="Center">
                    <font fontName="SansSerif" size="7" isBold="true"/>
                </textElement>
                <text><![CDATA[ID]]></text>
            </staticText>
            <staticText>
                <reportElement x="35" y="5" width="138" height="14" forecolor="#FFFFFF"/>
                <textElement>
                    <font fontName="SansSerif" size="7" isBold="true"/>
                </textElement>
                <text><![CDATA[CLIENTE]]></text>
            </staticText>
            <staticText>
                <reportElement x="173" y="5" width="138" height="14" forecolor="#FFFFFF"/>
                <textElement>
                    <font fontName="SansSerif" size="7" isBold="true"/>
                </textElement>
                <text><![CDATA[EQUIPAMENTO]]></text>
            </staticText>
            <staticText>
                <reportElement x="311" y="5" width="78" height="14" forecolor="#FFFFFF"/>
                <textElement textAlignment="Center">
                    <font fontName="SansSerif" size="7" isBold="true"/>
                </textElement>
                <text><![CDATA[RETIRADA]]></text>
            </staticText>
            <staticText>
                <reportElement x="389" y="5" width="83" height="14" forecolor="#FFFFFF"/>
                <textElement textAlignment="Center">
                    <font fontName="SansSerif" size="7" isBold="true"/>
                </textElement>
                <text><![CDATA[PREV. DEV.]]></text>
            </staticText>
            <staticText>
                <reportElement x="472" y="5" width="83" height="14" forecolor="#FFFFFF"/>
                <textElement textAlignment="Center">
                    <font fontName="SansSerif" size="7" isBold="true"/>
                </textElement>
                <text><![CDATA[DEVOLUÇÃO]]></text>
            </staticText>
            <staticText>
                <reportElement x="555" y="5" width="78" height="14" forecolor="#FFFFFF"/>
                <textElement textAlignment="Right">
                    <font fontName="SansSerif" size="7" isBold="true"/>
                </textElement>
                <text><![CDATA[VALOR (R$)]]></text>
            </staticText>
            <staticText>
                <reportElement x="633" y="5" width="167" height="14" forecolor="#FFFFFF"/>
                <textElement textAlignment="Center">
                    <font fontName="SansSerif" size="7" isBold="true"/>
                </textElement>
                <text><![CDATA[STATUS]]></text>
            </staticText>
        </band>
    </columnHeader>

    <!-- Detalhe -->
    <detail>
        <band height="18" splitType="Stretch">
            <rectangle>
                <reportElement x="0" y="0" width="802" height="18"
                               backcolor="#F7F9FC" forecolor="#F7F9FC" mode="Opaque">
                    <printWhenExpression><![CDATA[$V{REPORT_COUNT} % 2 == 0]]></printWhenExpression>
                </reportElement>
            </rectangle>

            <line>
                <reportElement x="0" y="17" width="802" height="1" forecolor="#E8EEF7"/>
            </line>

            <textField isBlankWhenNull="true">
                <reportElement x="2" y="2" width="33" height="13" forecolor="#3A4A5C"/>
                <textElement textAlignment="Center">
                    <font fontName="SansSerif" size="8"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{id}]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true" textAdjust="StretchHeight">
                <reportElement x="35" y="2" width="136" height="13" forecolor="#3A4A5C"/>
                <textElement>
                    <font fontName="SansSerif" size="8"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{nomeCliente}]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true" textAdjust="StretchHeight">
                <reportElement x="173" y="2" width="136" height="13" forecolor="#3A4A5C"/>
                <textElement>
                    <font fontName="SansSerif" size="8"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{nomeEquipamento}]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement x="311" y="2" width="78" height="13" forecolor="#3A4A5C"/>
                <textElement textAlignment="Center">
                    <font fontName="SansSerif" size="8"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{dataRetirada}]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement x="389" y="2" width="83" height="13" forecolor="#3A4A5C"/>
                <textElement textAlignment="Center">
                    <font fontName="SansSerif" size="8"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{dataPrevDevolucao}]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement x="472" y="2" width="83" height="13" forecolor="#3A4A5C"/>
                <textElement textAlignment="Center">
                    <font fontName="SansSerif" size="8"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{dataDevolucao}]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true" pattern="#,##0.00">
                <reportElement x="555" y="2" width="76" height="13" forecolor="#1A3A5C"/>
                <textElement textAlignment="Right">
                    <font fontName="SansSerif" size="8" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{valorTotal}]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement x="633" y="2" width="167" height="13" forecolor="#3A4A5C"/>
                <textElement textAlignment="Center">
                    <font fontName="SansSerif" size="8"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{status}]]></textFieldExpression>
            </textField>
        </band>
    </detail>

    <!-- Rodape de pagina -->
    <pageFooter>
        <band height="18">
            <line>
                <reportElement x="0" y="0" width="802" height="1" forecolor="#DDE1E7"/>
            </line>
            <staticText>
                <reportElement x="0" y="4" width="400" height="12" forecolor="#8A9BB0"/>
                <textElement>
                    <font fontName="SansSerif" size="7"/>
                </textElement>
                <text><![CDATA[Sistema de Aluguel de Equipamentos - Relatório de Aluguel]]></text>
            </staticText>
            <textField>
                <reportElement x="400" y="4" width="402" height="12" forecolor="#8A9BB0"/>
                <textElement textAlignment="Right">
                    <font fontName="SansSerif" size="7"/>
                </textElement>
                <textFieldExpression><![CDATA["Página " + $V{PAGE_NUMBER} + " de " + $V{PAGE_COUNT}]]></textFieldExpression>
            </textField>
        </band>
    </pageFooter>

    <!-- Sumario -->
    <summary>
        <band height="58" splitType="Stretch">
            <line>
                <reportElement x="0" y="6" width="802" height="1" forecolor="#2A5480"/>
            </line>

            <rectangle>
                <reportElement x="0" y="8" width="802" height="46"
                               backcolor="#EEF4FB" forecolor="#EEF4FB" mode="Opaque"/>
            </rectangle>

            <staticText>
                <reportElement x="10" y="14" width="300" height="14" forecolor="#1A3A5C"/>
                <textElement>
                    <font fontName="SansSerif" size="9" isBold="true"/>
                </textElement>
                <text><![CDATA[RESUMO DO PERÍODO]]></text>
            </staticText>

            <staticText>
                <reportElement x="340" y="14" width="210" height="13" forecolor="#3A4A5C"/>
                <textElement textAlignment="Right">
                    <font fontName="SansSerif" size="8"/>
                </textElement>
                <text><![CDATA[Registros encontrados:]]></text>
            </staticText>
            <textField>
                <reportElement x="555" y="14" width="237" height="13" forecolor="#1A3A5C"/>
                <textElement textAlignment="Right">
                    <font fontName="SansSerif" size="8" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$V{COUNT_ROWS} + " registro(s)"]]></textFieldExpression>
            </textField>

            <staticText>
                <reportElement x="340" y="30" width="210" height="13" forecolor="#3A4A5C"/>
                <textElement textAlignment="Right">
                    <font fontName="SansSerif" size="8"/>
                </textElement>
                <text><![CDATA[Total de Aluguéis (R$):]]></text>
            </staticText>
            <textField pattern="R$ #,##0.00">
                <reportElement x="555" y="30" width="155" height="13" forecolor="#1E6B3A"/>
                <textElement textAlignment="Right">
                    <font fontName="SansSerif" size="8" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$V{SUM_VALOR}]]></textFieldExpression>
            </textField>

            <line>
                <reportElement x="0" y="56" width="802" height="1" forecolor="#DDE1E7"/>
            </line>
        </band>
    </summary>
</jasperReport>
